datasource db {
  provider = "sqlite"
  url      = "file:./scan-wallet.sqlite"
}

generator client {
  provider      = "prisma-client-js"
  output        = "./client"
  binaryTargets = ["native", "windows", "darwin", "debian-openssl-1.1.x"]
}

model Tab {
  id        String    @id() @default(cuid())
  createdAt DateTime  @default(now())
  name      String
  Stepper   Stepper[]
}

model Stepper {
  id          String        @id() @default(cuid())
  createdAt   DateTime      @default(now())
  tab         Tab           @relation(fields: [tabId], references: [id])
  tabId       String
  from        String
  to          String
  value       Float
  data        String
  gasLimit    Int
  gasPrice    Int
  Transaction Transaction[]
}

model Transaction {
  id        String   @id() @default(cuid())
  createdAt DateTime @default(now())
  stepper   Stepper  @relation(fields: [stepperId], references: [id])
  stepperId String
  hash      String   @unique()
  gasUsed   Int
}
