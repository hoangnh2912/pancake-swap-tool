datasource db {
  provider = "sqlite"
  url      = "file:./scan-transfer.sqlite"
}

generator client {
  provider      = "prisma-client-js"
  output        = "./client"
  binaryTargets = ["native", "windows", "darwin", "debian-openssl-1.1.x"]
}

model ScanWallet {
  id            String   @id() @default(cuid())
  wallet        String
  tx            String
  token         String?
  destination   String?
  amount        String?
  isTransferred Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([destination])
}
