generator client {
  provider      = "prisma-client-js"
  output        = "./client"
  binaryTargets = ["native", "windows", "darwin", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./auto-deploy.sqlite"
}

model Config {
  id           String @id @default("default")
  rpc          String @default("https://bsc.drpc.org")
  chainId      String @default("56")
  mainKey      String @default("")
  swapKey      String @default("")
  mintKey      String @default("")
  contractCode String @default("")
  tokensJson        String @default("[]")
  solcVersion       String @default("0.8.27")
  swapCommandsJson  String @default("[]")
  swapDelay         String @default("0")
  transferBnbToMain String @default("")
  scanContract      String @default("")
  disperseAmount    String @default("")
  scanDelay         String @default("30")
}
